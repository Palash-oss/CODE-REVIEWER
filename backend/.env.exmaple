# App
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ai_code_review

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# File uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_DIR=./uploads

# Note: AI provider credentials (Base URL / API Key / Model) are NOT here.
# Per spec, those are user-configured per-project at runtime and stored
# in the ai_provider_configs table — never hardcoded or env-based.